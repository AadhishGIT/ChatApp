# ==============================================================================
# DocuMind: Environment Variables (100% Free Production Stack)
# ==============================================================================

# Google Gemini API Key (Get free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase Credentials (Get free from https://supabase.com)
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Production & CORS Settings
# Set to your deployed Vercel frontend URL, e.g. https://your-app.vercel.app, or "*" for any
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Document Ingestion limits
MAX_UPLOAD_BYTES=26214400
MAX_QUESTION_LENGTH=4000
RETRIEVAL_K=8
OCR_MAX_PAGES=5
OCR_MODEL=gemini-2.5-flash-lite
LOG_LEVEL=INFO
